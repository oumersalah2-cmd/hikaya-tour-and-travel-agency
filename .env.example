# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://hikayatour.com

# ---- Admin panel (/admin) -------------------------------------------------
# Password for the admin login. Use a long, unique one.
ADMIN_PASSWORD=
# (12+ characters; generate one with: openssl rand -base64 18)
# Random string (16+ chars) used to sign the login cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Storage. On Vercel add the Upstash Redis integration (sets these two automatically):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Without Redis (VPS / Docker) data is stored on disk instead. Default: ./data
# DATA_DIR=/var/lib/hikaya

# ---- Optional ---------------------------------------------------------------
# Also forward every contact / booking / newsletter submission (JSON POST) to
# Formspree, Make, Zapier, n8n, Google Apps Script… for e-mail or chat alerts.
CONTACT_WEBHOOK_URL=
